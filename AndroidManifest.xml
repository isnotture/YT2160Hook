plugins {
    id 'com.android.application'
}

android {
    namespace 'io.github.yt2160hook'
    compileSdk 35

    defaultConfig {
        applicationId 'io.github.yt2160hook'
        minSdk 23
        targetSdk 28
        versionCode 1
        versionName '0.1.0'
    }

    compileOptions {
        sourceCompatibility JavaVersion.VERSION_17
        targetCompatibility JavaVersion.VERSION_17
    }

    buildTypes {
        release {
            minifyEnabled false
        }
    }
}

dependencies {
    compileOnly 'de.robv.android.xposed:api:82'
}
